{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  
  "data": {
    "url": "https://raw.githubusercontent.com/Ark111201/DV2/refs/heads/main/data/hh_poverty_state(with_poverty_absolute).csv",
    "format": { "type": "csv", "parse": {"date": "date:'%d/%m/%Y'"} }
  },
  "transform": [
    {
      "calculate": "indexof(['Perlis', 'Kedah', 'Pulau Pinang', 'Perak'], datum.state) >= 0 ? '1. Northern Region' : indexof(['Kelantan', 'Terengganu', 'Pahang'], datum.state) >= 0 ? '2. East Coast Region' : indexof(['Sabah', 'Sarawak', 'W.P. Labuan'], datum.state) >= 0 ? '4. East Malaysia' : '3. Central & Southern'",
      "as": "region"
    }
  ],
  "facet": {
    "field": "region",
    "type": "nominal",
    "columns": 2,
    "title": null
  },
  "spec": {
    "width": 270,
    "height": 220,
    "layer": [
      {
        "comment": "--- MAIN LINES ---",
        "mark": { "type": "line", "interpolate": "monotone", "strokeWidth": 2.5 },
        "encoding": {
          "x": {
            "field": "date",
            "type": "temporal",
            "title": "Year",
            "axis": {"grid": false, "format": "%Y"}
          },
          "y": {
            "field": "poverty_absolute",
            "type": "quantitative",
            "title": "Poverty Rate (%)",
            "scale": {"domain": [0, 80]}
          },
          "color": {
            "field": "state",
            "type": "nominal",
            "scale": {"scheme": "tableau20"},
            "legend": {
              "title": "States of Malaysia",
              "labelFontSize": 11,
              "symbolType": "circle"
            }
          }
        }
      },
      {
        "comment": "--- DATA POINTS ---",
        "mark": {"type": "circle", "size": 40, "filled": true},
        "encoding": {
          "x": {"field": "date", "type": "temporal"},
          "y": {"field": "poverty_absolute", "type": "quantitative"},
          "color": {"field": "state", "type": "nominal"},
          "tooltip": [
            {"field": "state", "type": "nominal", "title": "State"},
            {"field": "date", "type": "temporal", "timeUnit": "year", "title": "Year"},
            {"field": "poverty_absolute", "type": "quantitative", "title": "Poverty (%)", "format": ".1f"}
          ]
        }
      }
    ]
  },
  "resolve": {
    "scale": { "color": "shared", "y": "shared" },
    "legend": { "color": "shared" }
  },
  "config": {
    "view": {"stroke": null},
    "header": { "labelFontSize": 14, "labelFontWeight": "bold", "labelPadding": 10 }
  }
}
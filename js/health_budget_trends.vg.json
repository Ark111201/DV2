{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "bounds": "flush",
  "title": {
    "text": "Ministry of Health (MOH) Budget Allocation Trends (2015-2024)",
    "subtitle": [
      "Stacked area chart showing the total MOH budget split into Operating Expenditure (OE) and Development Expenditure (DE) from 2015 to 2024.",
  "   OE covers recurring costs such as salaries and supplies; DE covers capital investment in hospitals and infrastructure."
    ],
    "fontSize": 25,
    "subtitleFontSize": 16,
    "subtitleFontStyle": "italic",
    "anchor": "start",
    "offset": 15,
    "subtitlePadding": 15,
    "font": "sans-serif",
    "subtitleFont": "sans-serif"
  },
  "width": 1050,
  "height": 380,
  "data": {
    "url": "https://raw.githubusercontent.com/Ark111201/DV2/refs/heads/main/data/budget_allocation_clean.csv",
    "format": {
      "type": "csv",
      "parse": {"date": "date:'%d/%m/%Y'"}
    }
  },
  "transform": [
    {
      "calculate": "datum.category == 'de' ? 'Development Expenditure (DE)' : 'Operating Expenditure (OE)'",
      "as": "expenditure_type"
    }
  ],
  "layer": [
    {
      "mark": {
        "type": "area",
        "opacity": 0.80,
        "interpolate": "monotone",
        "line": {"strokeWidth": 2}
      },
      "encoding": {
        "x": {
          "field": "date",
          "type": "temporal",
          "title": "Year",
          "axis": {
            "format": "%Y",
            "grid": false,
            "labelFont": "sans-serif",
            "titleFont": "sans-serif",
            "labelPadding": 6,
            "tickCount": 10
          }
        },
        "y": {
          "field": "allocation",
          "type": "quantitative",
          "title": "Budget Allocation (RM)",
          "stack": true,
          "axis": {
            "grid": true,
            "gridOpacity": 0.2,
            "labelFont": "sans-serif",
            "titleFont": "sans-serif",
            "labelExpr": "datum.value == 0 ? 'RM 0' : 'RM ' + (datum.value / 1000000000) + 'B'"
          }
        },
        "color": {
          "field": "expenditure_type",
          "type": "nominal",
          "scale": {
            "domain": ["Operating Expenditure (OE)", "Development Expenditure (DE)"],
            "range": ["#3d7a6b", "#c9972a"]
          },
          "legend": {
            "orient": "bottom",
            "title": null,
            "direction": "horizontal",
            "labelFont": "sans-serif",
            "labelFontSize": 12,
            "padding": 15,
            "symbolType": "square",
            "symbolSize": 150,
            "labelLimit": 300
          }
        },
        "tooltip": [
          {"field": "date", "type": "temporal", "timeUnit": "year", "title": "Year"},
          {"field": "expenditure_type", "type": "nominal", "title": "Type"},
          {"field": "allocation", "type": "quantitative", "title": "Allocation (RM)", "format": ",.0f"}
        ]
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#333333",
        "strokeDash": [5, 4],
        "strokeWidth": 1.5,
        "opacity": 0.7
      },
      "encoding": {
        "x": {"datum": {"year": 2020}, "type": "temporal"}
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#333333",
        "strokeDash": [5, 4],
        "strokeWidth": 1.5,
        "opacity": 0.7
      },
      "encoding": {
        "x": {"datum": {"year": 2022}, "type": "temporal"}
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#333333",
        "strokeDash": [5, 4],
        "strokeWidth": 1.5,
        "opacity": 0.7
      },
      "encoding": {
        "x": {"datum": {"year": 2024}, "type": "temporal"}
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#333333",
        "strokeWidth": 1.5,
        "opacity": 0.85
      },
      "encoding": {
        "x": {"datum": {"year": 2020}, "type": "temporal"},
        "x2": {"datum": {"year": 2022}, "type": "temporal"},
        "y": {"datum": 28000000000, "type": "quantitative"}
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#333333",
        "strokeWidth": 1.5,
        "opacity": 0.85
      },
      "encoding": {
        "x": {"datum": {"year": 2020}, "type": "temporal"},
        "y": {"datum": 27200000000, "type": "quantitative"},
        "y2": {"datum": 28800000000, "type": "quantitative"}
      }
    },
    {
      "mark": {
        "type": "rule",
        "color": "#333333",
        "strokeWidth": 1.5,
        "opacity": 0.85
      },
      "encoding": {
        "x": {"datum": {"year": 2022}, "type": "temporal"},
        "y": {"datum": 27200000000, "type": "quantitative"},
        "y2": {"datum": 28800000000, "type": "quantitative"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -12,
        "fontSize": 11,
        "fontStyle": "italic",
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "x": {"datum": {"year": 2021}, "type": "temporal"},
        "y": {"datum": 28000000000, "type": "quantitative"},
        "text": {"value": "OE stagnant: +0.3% (2020–2022)"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -165,
        "fontSize": 11,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "x": {"datum": {"year": 2023}, "type": "temporal"},
        "text": {"value": "Post-COVID surge"}
      }
    },
    {
      "mark": {
        "type": "text",
        "align": "center",
        "dy": -150,
        "fontSize": 11,
        "fontStyle": "italic",
        "color": "#333333"
      },
      "encoding": {
        "x": {"datum": {"year": 2023}, "type": "temporal"},
        "text": {"value": "Total +27.2% in 2 years"}
      }
    },
    {
      "transform": [
        {"filter": "year(datum.date) == 2024"},
        {
          "aggregate": [{"op": "sum", "field": "allocation", "as": "total"}],
          "groupby": ["date"]
        }
      ],
      "mark": {
        "type": "text",
        "align": "right",
        "dx": -6,
        "dy": -10,
        "fontSize": 12,
        "fontWeight": "bold",
        "color": "#333333"
      },
      "encoding": {
        "x": {"field": "date", "type": "temporal"},
        "y": {"field": "total", "type": "quantitative"},
        "text": {"value": "RM 41.2B"}
      }
    }
  ],
  "config": {
    "axis": {"grid": false},
    "view": {"stroke": null}
  }
}
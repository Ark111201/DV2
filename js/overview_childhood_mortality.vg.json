{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "bounds": "flush",
  "title": {
    "text": "Early Childhood Mortality Rate by Region & Type (2023)",
    "subtitle": [
      "This multi-panel chart shows the breakdown of early childhood mortality rates across major geographic regions."
    ],
    "fontSize": 25,
    "subtitleFontSize": 16,
    "subtitleFontStyle": "italic",
    "anchor": "start",
    "offset": 15,
    "subtitlePadding": 15,
    "font": "sans-serif",
    "subtitleFont": "sans-serif"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/Ark111201/DV2/refs/heads/main/data/deaths_early_childhood_state(2023).csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "calculate": "indexof(['Selangor', 'Pulau Pinang', 'Johor', 'Perak', 'Melaka', 'Negeri Sembilan', 'Kedah', 'Perlis'], datum.state) >= 0 ? '1. West Coast Peninsular' : indexof(['Kelantan', 'Terengganu', 'Pahang'], datum.state) >= 0 ? '2. East Coast Peninsular' : indexof(['Sabah', 'Sarawak'], datum.state) >= 0 ? '3. East Malaysia' : '4. Federal Territories'",
      "as": "region"
    },
    {
      "aggregate": [{"op": "mean", "field": "rate", "as": "mean_rate"}],
      "groupby": ["region", "type"]
    }
  ],
  "facet": {
    "field": "region",
    "header": {
      "labelFontSize": 12,
      "labelFontWeight": "bold",
      "labelPadding": 10,
      "title": null
    }
  },
  "columns": 4,
  "spec": {
    "width": 240,
    "height": 280,
    "layer": [
      {
        "mark": {"type": "bar", "tooltip": true},
        "encoding": {
          "x": {
            "field": "type",
            "type": "nominal",
            "sort": ["perinatal", "neonatal", "infant", "toddler"],
            "title": null,
            "axis": {
              "labelAngle": -45,
              "labelFont": "sans-serif",
              "labelFontSize": 11
            }
          },
          "y": {
            "field": "mean_rate",
            "type": "quantitative",
            "title": "Mean Mortality Rate (per 1,000)",
            "axis": {
              "labelFont": "sans-serif",
              "titleFont": "sans-serif",
              "titleFontSize": 11
            }
          },
          "color": {
            "field": "type",
            "type": "nominal",
            "scale": {
              "domain": ["perinatal", "neonatal", "infant", "toddler"],
              "range": ["#1b6ca8", "#3a9e8f", "#d4a843", "#8b7355"]
            },
            "legend": {
              "orient": "bottom",
              "title": null,
              "direction": "horizontal",
              "labelFont": "sans-serif",
              "labelFontSize": 11,
              "labelLimit": 200
            }
          },
          "tooltip": [
            {"field": "region", "type": "nominal", "title": "Region"},
            {"field": "type", "type": "nominal", "title": "Mortality Type"},
            {"field": "mean_rate", "type": "quantitative", "title": "Mean Rate", "format": ".2f"}
          ]
        }
      },
      {
        "transform": [],
        "mark": {
          "type": "text",
          "align": "center",
          "dy": -8,
          "fontSize": 10,
          "fontWeight": "bold",
          "color": "#333333"
        },
        "encoding": {
          "x": {
            "field": "type",
            "type": "nominal",
            "sort": ["perinatal", "neonatal", "infant", "toddler"]
          },
          "y": {
            "field": "mean_rate",
            "type": "quantitative"
          },
          "text": {
            "field": "mean_rate",
            "type": "quantitative",
            "format": ".1f"
          }
        }
      }
    ]
  },
  "resolve": {
    "scale": {"color": "shared", "y": "shared"},
    "legend": {"color": "shared"}
  },
  "config": {
    "axis": {"grid": false},
    "view": {"stroke": null}
  }
}
{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "bounds": "flush",
  "title": {
    "text": "3. Early Childhood Mortality Rate by Region & Type (2023)",
    "subtitle": [
      "The population pyramid displays the age and gender distribution for the specific district selected on the map.",
      "This multi-panel chart shows the breakdown of early childhood mortality rates across major geographic regions."
    ],
    "fontSize": 18,
    "subtitleFontSize": 13,
    "subtitleFontStyle": "italic",
    "anchor": "start",
    "offset": 15,
    "font": "sans-serif",
    "subtitleFont": "sans-serif"
  },
  "data": {
    "url": "https://raw.githubusercontent.com/Ark111201/DV2/refs/heads/main/data/deaths_early_childhood_state(2023).csv",
    "format": {"type": "csv"}
  },
  "transform": [
    {
      "calculate": "indexof(['Selangor', 'Pulau Pinang', 'Johor', 'Perak', 'Melaka', 'Negeri Sembilan', 'Kedah', 'Perlis'], datum.state) >= 0 ? '1. West Coast Peninsular' : indexof(['Kelantan', 'Terengganu', 'Pahang'], datum.state) >= 0 ? '2. East Coast Peninsular' : indexof(['Sabah', 'Sarawak'], datum.state) >= 0 ? '3. East Malaysia' : '4. Federal Territories'",
      "as": "region"
    },
    {
      "aggregate": [{"op": "mean", "field": "rate", "as": "mean_rate"}],
      "groupby": ["region", "type"]
    }
  ],
  "facet": {
    "field": "region",
    "header": {
      "labelFontSize": 12,
      "labelFontWeight": "bold",
      "labelPadding": 10,
      "title": null
    }
  },
  "columns": 4,
  "spec": {
    "width": 180,
    "height": 250,
    "mark": {
      "type": "bar",
      "tooltip": true
    },
    "encoding": {
      "x": {
        "field": "type",
        "type": "nominal",
        "sort": ["perinatal", "neonatal", "infant", "toddler"],
        "title": null,
        "axis": {
          "labelAngle": -45,
          "labelFont": "sans-serif",
          "labelFontSize": 11
        }
      },
      "y": {
        "field": "mean_rate",
        "type": "quantitative",
        "title": "Mean Mortality Rate (per 1,000)",
        "axis": {
          "labelFont": "sans-serif",
          "titleFont": "sans-serif",
          "titleFontSize": 11
        }
      },
      "color": {
        "field": "type",
        "type": "nominal",
        "scale": {"scheme": "tableau10"},
        "legend": {
          "orient": "bottom",
          "title": null,
          "direction": "horizontal",
          "labelFont": "sans-serif",
          "labelFontSize": 11
        }
      },
      "tooltip": [
        {"field": "region", "type": "nominal", "title": "Region"},
        {"field": "type", "type": "nominal", "title": "Mortality Type"},
        {"field": "mean_rate", "type": "quantitative", "title": "Mean Rate", "format": ".2f"}
      ]
    }
  },
  "resolve": {
    "scale": {"color": "shared", "y": "shared"},
    "legend": {"color": "shared"}
  },
  "config": {
    "axis": {"grid": false},
    "view": {"stroke": null}
  }
}